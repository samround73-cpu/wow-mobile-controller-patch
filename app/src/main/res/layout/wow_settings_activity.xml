<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:title="@string/wow_settings"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wow_settings_note"
                android:textSize="13sp"
                android:textColor="?attr/colorSecondaryText"/>

            <TextView
                android:id="@+id/TVLocale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:textColor="?attr/colorSecondaryText"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/wow_realm_server"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryText"/>

            <Spinner
                android:id="@+id/SRealmlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>

            <EditText
                android:id="@+id/ETCustomRealmlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/wow_custom_realmlist_hint"
                android:inputType="textUri"
                android:visibility="gone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/wow_resolution"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryText"/>

            <Spinner
                android:id="@+id/SResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/wow_view_distance"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryText"/>

            <Spinner
                android:id="@+id/SFarclip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/wow_frame_rate"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryText"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wow_frame_rate_note"
                android:textSize="13sp"
                android:textColor="?attr/colorSecondaryText"/>

            <Spinner
                android:id="@+id/SMaxFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/wow_autologin"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimaryText"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wow_autologin_note"
                android:textSize="13sp"
                android:textColor="?attr/colorSecondaryText"/>

            <CheckBox
                android:id="@+id/CBAutoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wow_autologin_enable"/>

            <EditText
                android:id="@+id/ETAutoLoginAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/wow_autologin_account"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:importantForAutofill="no"/>

            <EditText
                android:id="@+id/ETAutoLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/wow_autologin_password"
                android:inputType="textPassword"
                android:importantForAutofill="no"/>

            <EditText
                android:id="@+id/ETAutoLoginDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/wow_autologin_delay"
                android:inputType="number"
                android:importantForAutofill="no"/>

            <CheckBox
                android:id="@+id/CBAutoLoginEnterWorld"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wow_autologin_enter_world"/>

            <Button
                android:id="@+id/BTSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/wow_save"
                android:backgroundTint="?attr/colorAccent"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
